[Unit]
# Stands down by itself once the ability folder is gone: OpenHome has no uninstall hook.
ConditionPathExists=@INSTALL_DIR@/devkit_functions.py
Description=OpenFile volume
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/default/openfile
ExecStart=/usr/bin/python3 @INSTALL_DIR@/devkit_functions.py enable_drive
ExecStop=/usr/bin/python3 @INSTALL_DIR@/devkit_functions.py disable_drive

[Install]
WantedBy=multi-user.target
